<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Tamil meme page by Aswath — memes, reactions, and relatable moments.">
  <title>Semma Scene Memes 😂 | Aswath</title>
  <style>
    :root {
      --bg: #0c0c10;
      --panel: #17171f;
      --text: #f7f7fb;
      --muted: #a5a5b5;
      --accent: #ffd166;
      --pink: #ff6b9a;
      --line: rgba(255,255,255,.1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      color: var(--text);
      background:
        radial-gradient(circle at 12% 0%, rgba(255,107,154,.13), transparent 28rem),
        radial-gradient(circle at 90% 15%, rgba(255,209,102,.10), transparent 30rem),
        var(--bg);
      font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
      line-height: 1.55;
    }
    a { color: inherit; text-decoration: none; }
    .wrap { width: min(1120px, 92%); margin: auto; }
    header {
      position: sticky; top: 0; z-index: 10;
      background: rgba(12,12,16,.85); backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--line);
    }
    nav { min-height: 70px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .brand { font-size: 1.12rem; font-weight: 950; letter-spacing: -.04em; }
    .brand span { color: var(--accent); }
    .links { display: flex; gap: 20px; color: var(--muted); font-size: .92rem; }
    .links a:hover { color: var(--accent); }
    .hero { padding: 66px 0 45px; display: grid; grid-template-columns: 1fr .8fr; gap: 36px; align-items: center; }
    .badge { display: inline-block; padding: 7px 12px; border-radius: 99px; background: #ffffff0b; border: 1px solid var(--line); color: var(--accent); font-size: .8rem; font-weight: 800; }
    h1 { font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: .99; letter-spacing: -.065em; margin: 20px 0; }
    h1 .highlight { color: var(--accent); }
    .hero p { max-width: 590px; color: var(--muted); font-size: 1.06rem; }
    .buttons { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px; }
    .btn { display: inline-block; padding: 11px 16px; border-radius: 12px; font-weight: 850; border: 1px solid var(--line); transition: transform .2s, background .2s; }
    .btn:hover { transform: translateY(-2px); }
    .btn.main { background: var(--accent); color: #17130a; border-color: var(--accent); }
    .hero-meme { background: var(--panel); border: 1px solid var(--line); padding: 10px; border-radius: 20px; transform: rotate(1deg); box-shadow: 0 25px 75px #0008; }
    .hero-meme img { display: block; width: 100%; border-radius: 12px; }
    .hero-meme small { display: block; text-align: center; padding: 10px 4px 2px; color: var(--muted); }
    .ticker { overflow: hidden; border-block: 1px solid var(--line); background: #ffffff05; white-space: nowrap; }
    .ticker div { padding: 12px 0; width: max-content; color: var(--accent); font-weight: 900; letter-spacing: .08em; animation: slide 24s linear infinite; }
    @keyframes slide { to { transform: translateX(-50%); } }
    section { padding: 64px 0; scroll-margin-top: 80px; }
    .section-top { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 24px; }
    h2 { font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.1; letter-spacing: -.045em; }
    .muted { color: var(--muted); }
    .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
    .filter { background: var(--panel); color: var(--text); border: 1px solid var(--line); padding: 8px 13px; border-radius: 99px; cursor: pointer; font: inherit; }
    .filter.active, .filter:hover { background: var(--accent); color: #17130a; border-color: var(--accent); }
    .meme-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .meme-card { overflow: hidden; background: var(--panel); border: 1px solid var(--line); border-radius: 17px; transition: transform .2s, border-color .2s; }
    .meme-card:hover { transform: translateY(-5px); border-color: #ffd16680; }
    .meme-card img { width: 100%; display: block; aspect-ratio: 16/9; object-fit: cover; background: #24242b; }
    .meme-info { padding: 15px; }
    .meme-info h3 { font-size: 1.04rem; margin-bottom: 5px; }
    .meme-info p { color: var(--muted); font-size: .9rem; }
    .meme-actions { display: flex; gap: 10px; margin-top: 13px; }
    .like { border: 1px solid var(--line); color: var(--text); background: #ffffff08; border-radius: 9px; padding: 7px 10px; cursor: pointer; }
    .like:hover { border-color: var(--pink); }
    .tag { color: var(--accent); font-size: .75rem; font-weight: 850; text-transform: uppercase; letter-spacing: .08em; }
    .submit-box { background: linear-gradient(135deg, #211a2a, #17171f); border: 1px solid var(--line); border-radius: 20px; padding: 28px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
    .submit-box p { color: var(--muted); margin-top: 7px; }
    footer { border-top: 1px solid var(--line); padding: 24px 0; color: var(--muted); font-size: .9rem; }
    .footer-inner { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .empty { display: none; color: var(--muted); padding: 20px 0; }
    @media (max-width: 800px) {
      .hero { grid-template-columns: 1fr; }
      .hero-meme { max-width: 600px; transform: none; }
      .meme-grid { grid-template-columns: repeat(2, 1fr); }
      .section-top { align-items: start; flex-direction: column; }
      .submit-box { align-items: start; flex-direction: column; }
    }
    @media (max-width: 520px) {
      .links { gap: 10px; font-size: .78rem; }
      .brand { font-size: .96rem; }
      .meme-grid { grid-template-columns: 1fr; }
      .hero { padding-top: 45px; }
      section { padding: 48px 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <header>
    <nav class="wrap">
      <a class="brand" href="#home">SEMMA SCENE <span>MEMES 😂</span></a>
      <div class="links">
        <a href="#memes">Memes</a>
        <a href="#categories">Categories</a>
        <a href="#about">About</a>
      </div>
    </nav>
  </header>

  <main>
    <div class="wrap hero" id="home">
      <div>
        <span class="badge">TAMIL MEMES · DAILY DOSE OF FUN</span>
        <h1>Scroll pannunga.<br><span class="highlight">Sirichittu</span> ponga. 😂</h1>
        <p>Welcome to Aswath’s meme corner — Tamil reactions, college-life comedy, relatable moments, and memes for every “enna da nadakkuthu?” situation.</p>
        <div class="buttons">
          <a class="btn main" href="#memes">😂 Browse memes</a>
          <a class="btn" href="#about">About this page</a>
        </div>
      </div>
      <aside class="hero-meme">
        <img src="assets/aahn-aprom-sami-meme.png" alt="Aahn aprom Sami reaction meme">
        <small>Featured reaction: “Aahn aprom…?” 😎</small>
      </aside>
    </div>

    <div class="ticker" aria-label="Meme page slogan">
      <div> TAMIL MEMES ✦ COLLEGE LIFE ✦ FRIENDS GROUP ✦ SAMI REACTIONS ✦ RELATABLE CONTENT ✦ TAMIL MEMES ✦ COLLEGE LIFE ✦ FRIENDS GROUP ✦ SAMI REACTIONS ✦ RELATABLE CONTENT ✦ </div>
    </div>

    <section id="memes">
      <div class="wrap">
        <div class="section-top">
          <div><p class="tag">The meme gallery</p><h2>Latest <span style="color:var(--accent)">memes</span> 🔥</h2></div>
          <p class="muted">One image to start. More memes can be added anytime.</p>
        </div>
        <div class="filters" id="categories">
          <button class="filter active" data-filter="all">All memes</button>
          <button class="filter" data-filter="reaction">Reactions</button>
          <button class="filter" data-filter="college">College life</button>
          <button class="filter" data-filter="relatable">Relatable</button>
        </div>
        <div class="meme-grid" id="memeGrid">
          <article class="meme-card" data-category="reaction">
            <img src="assets/aahn-aprom-sami-meme.png" alt="Aahn aprom Sami meme">
            <div class="meme-info">
              <span class="tag">Reaction meme</span>
              <h3>Aahn Aprom…? 😂</h3>
              <p>When someone explains the whole story and still hasn't reached the point.</p>
              <div class="meme-actions">
                <button class="like" type="button" aria-label="Like this meme">❤️ <span>0</span></button>
                <button class="like share" type="button">↗ Share</button>
              </div>
            </div>
          </article>
          <article class="meme-card" data-category="college">
            <img src="assets/aahn-aprom-sami-meme.png" alt="Sami reaction meme used as a college meme placeholder">
            <div class="meme-info">
              <span class="tag">College life</span>
              <h3>Friend: “Assignment mudichitiya?”</h3>
              <p>Me: “Aahn aprom…?” Naan innum question-e open pannala da. 😭</p>
              <div class="meme-actions">
                <button class="like" type="button" aria-label="Like this meme">❤️ <span>0</span></button>
                <button class="like share" type="button">↗ Share</button>
              </div>
            </div>
          </article>
          <article class="meme-card" data-category="relatable">
            <img src="assets/aahn-aprom-sami-meme.png" alt="Sami reaction meme used as a relatable meme placeholder">
            <div class="meme-info">
              <span class="tag">Relatable</span>
              <h3>When the story has 17 parts</h3>
              <p>“Seri bro, short-ah sollu…” — 45 minutes later: Aahn aprom? 😂</p>
              <div class="meme-actions">
                <button class="like" type="button" aria-label="Like this meme">❤️ <span>0</span></button>
                <button class="like share" type="button">↗ Share</button>
              </div>
            </div>
          </article>
        </div>
        <p class="empty" id="empty">No memes in this category yet.</p>
      </div>
    </section>

    <section id="about">
      <div class="wrap">
        <div class="submit-box">
          <div>
            <p class="tag">Behind the page</p>
            <h2>Made by <span style="color:var(--accent)">Aswath.L</span> 😎</h2>
            <p>A Tamil meme page for reactions, college comedy, and everyday chaos. More posts coming soon!</p>
          </div>
          <a class="btn main" href="#memes">Back to memes ↑</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footer-inner">
      <span>© <span id="year"></span> Semma Scene Memes</span>
      <span>Made for laughs, not for serious scenes. 😂</span>
    </div>
  </footer>

  <script>
    document.getElementById("year").textContent = new Date().getFullYear();

    // Filter memes by category.
    const filters = document.querySelectorAll(".filter");
    const cards = document.querySelectorAll(".meme-card");
    const empty = document.getElementById("empty");

    filters.forEach((button) => {
      button.addEventListener("click", () => {
        filters.forEach((item) => item.classList.remove("active"));
        button.classList.add("active");
        const category = button.dataset.filter;
        let visible = 0;

        cards.forEach((card) => {
          const show = category === "all" || card.dataset.category === category;
          card.style.display = show ? "" : "none";
          if (show) visible++;
        });
        empty.style.display = visible ? "none" : "block";
      });
    });

    // Simple demo likes (they reset when the page reloads).
    document.querySelectorAll(".like:not(.share)").forEach((button) => {
      button.addEventListener("click", () => {
        const count = button.querySelector("span");
        count.textContent = Number(count.textContent) + 1;
      });
    });

    // Share the page or copy its URL where supported.
    document.querySelectorAll(".share").forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          if (navigator.share) {
            await navigator.share({ title: document.title, text: "Check out this Tamil meme 😂", url: location.href });
          } else {
            await navigator.clipboard.writeText(location.href);
            button.textContent = "✓ Link copied";
          }
        } catch (error) {
          // Sharing was cancelled or not supported.
        }
      });
    });
  </script>
</body>
</html>
